
# Normalize text files in Git
* text=auto

# Python
*.py text eol=lf

# Configuration
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.env.example text eol=lf
.python-version text eol=lf
.gitignore text eol=lf

# SQL
*.sql text eol=lf

# Shell scripts
*.sh text eol=lf

# Documentation
*.md text eol=lf

# Dependency lockfile
uv.lock text eol=lf
