# Python virtual environments
.venv/
venv/

# Python cache and compiled files
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Testing and code quality
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.hypothesis/

# Environment variables and secrets
.env
.env.*
!.env.example

# Local credentials and TLS material
*.secret
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.csr

# Local runtime configuration
runtime.json

# IDE-specific local files
.idea/

# Operating system files
.DS_Store
Thumbs.db

# ============================================
# Local project documentation
# ============================================

# Keep Markdown documentation local
*.md

# Publish only the root README
!/README.md
