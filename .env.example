
# ==========================================
# AI Incident Commander - Environment
# ==========================================

# Application
APP_ENV=development
LOG_LEVEL=INFO

# OpenAI
OPENAI_API_KEY=

# PostgreSQL
POSTGRES_DB=incident_commander
POSTGRES_USER=incident_commander
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# SQLAlchemy AsyncEngine with Psycopg 3.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB
# WSL development: HOST=127.0.0.1, PORT=5433.
# Configure the real URL only in the private .env file.
DATABASE_URL=

# LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-incident-commander

# ==========================================
# Local Identity Infrastructure (Keycloak)
# ==========================================

# Canonical local OAuth hostname: auth.aic.test
# Keep port 8443 aligned with the issuer URL and Docker configuration.
AIC_KEYCLOAK_HTTPS_PORT=8443

# OAuth issuer:
# https://auth.aic.test:8443/realms/incidents

# Absolute paths to deployment-managed files outside the Git worktree.
# Configure the actual paths in the private .env file.
AIC_KEYCLOAK_DB_PASSWORD_FILE=
AIC_KEYCLOAK_TLS_CERT_FILE=
AIC_KEYCLOAK_TLS_KEY_FILE=

# ==========================================
# Local Observability Infrastructure
# ==========================================

# Local OTLP HTTP ingress, bound to host loopback only.
AIC_OTLP_HTTP_PORT=4318

# Must match the tenant configured in the Observability MCP ACL.
AIC_LOKI_TENANT=tenant-1

# Absolute path to the externally managed htpasswd file.
# Never commit the file or its contents.
AIC_OTLP_HTPASSWD_FILE=

# ==========================================
# Observability MCP
# ==========================================

# Private MCP endpoint:
# https://observability-mcp:8000/mcp

# Runtime configuration, TLS certificates and OAuth client secrets
# are managed outside the Git worktree.
#
# See compose.mcp.yaml and the local runtime template:
# deploy/observability/observability-mcp-runtime.local.example.json
#
# Production-oriented reference (requires deployment-specific configuration):
# deploy/observability/observability-mcp-runtime.example.json
