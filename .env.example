
# ==========================================
# AI Incident Commander - Environment
# ==========================================

# Application
APP_ENV=development
LOG_LEVEL=INFO

# OpenAI
OPENAI_API_KEY=

# PostgreSQL
POSTGRES_DB=incident_commander
POSTGRES_USER=incident_commander
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# SQLAlchemy AsyncEngine with Psycopg 3.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DB
# WSL development: HOST=127.0.0.1, PORT=5433.
# Configure the real URL only in the private .env file.
DATABASE_URL=

# LangSmith
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-incident-commander
